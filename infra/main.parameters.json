{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "sqlAdminObjectId": {
      "value": "${TRUDY_SQL_ADMIN_OBJECT_ID}"
    },
    "sqlAdminLogin": {
      "value": "${TRUDY_SQL_ADMIN_LOGIN}"
    },
    "sqlAdminPrincipalType": {
      "value": "${TRUDY_SQL_ADMIN_PRINCIPAL_TYPE}"
    },
    "tenantId": {
      "value": "${AZURE_TENANT_ID}"
    },
    "containerImage": {
      "value": "${SERVICE_WEB_IMAGE_NAME}"
    }
  }
}
