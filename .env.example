AZURE_LOCATION=eastus2
TRUDY_DB_PROVIDER=duckdb
TRUDY_DUCKDB_PATH=data/trudy.duckdb

# Required for Azure SQL mode.
TRUDY_SQL_SERVER=
TRUDY_SQL_DATABASE=sqldb-trudy

# Required by infra/main.parameters.json for azd provision.
TRUDY_SQL_ADMIN_OBJECT_ID=
TRUDY_SQL_ADMIN_LOGIN=
TRUDY_SQL_ADMIN_PRINCIPAL_TYPE=User
